{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/scanstitch/validation-fixtures.schema.json",
  "title": "ScanStitch Validation Fixture Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtures"],
  "properties": {
    "coverage_requirements": { "$ref": "#/$defs/coverageRequirements" },
    "fixtures": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/fixtureEntry" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "pathString": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "tagList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "pairLabel": {
      "type": "string",
      "pattern": "^[^|]+\\|[^|]+$"
    },
    "debugArtifactKind": {
      "enum": [
        "candidate_comparison",
        "gamut_clipping_map",
        "scene_referred_prophoto_float"
      ]
    },
    "coverageRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_fixtures": { "type": "integer", "minimum": 0 },
        "min_component_pairs": { "type": "integer", "minimum": 0 },
        "min_component_sha256_pairs": { "type": "integer", "minimum": 0 },
        "min_n_component_fixtures": { "type": "integer", "minimum": 0 },
        "min_component_sha256_sets": { "type": "integer", "minimum": 0 },
        "min_readable_tiff_pairs": { "type": "integer", "minimum": 0 },
        "min_tiff_layout_consistent_pairs": { "type": "integer", "minimum": 0 },
        "min_tiff_dimension_matched_pairs": { "type": "integer", "minimum": 0 },
        "min_tiff_bits_per_sample": { "type": "integer", "minimum": 0, "maximum": 16 },
        "min_summary_baselines": { "type": "integer", "minimum": 0 },
        "min_summary_baseline_sha256_fixtures": { "type": "integer", "minimum": 0 },
        "min_calibrated_fixtures": { "type": "integer", "minimum": 0 },
        "min_calibration_sha256_fixtures": { "type": "integer", "minimum": 0 },
        "min_uncalibrated_fixtures": { "type": "integer", "minimum": 0 },
        "min_unique_scanner_profiles": { "type": "integer", "minimum": 0 },
        "min_unique_roll_profiles": { "type": "integer", "minimum": 0 },
        "min_unique_film_stocks": { "type": "integer", "minimum": 0 },
        "min_scene_tags": { "type": "integer", "minimum": 0 },
        "min_exposure_tags": { "type": "integer", "minimum": 0 },
        "min_calibration_cases": { "type": "integer", "minimum": 0 },
        "min_film_stock_calibration_pairs": { "type": "integer", "minimum": 0 },
        "min_scene_exposure_pairs": { "type": "integer", "minimum": 0 },
        "min_reference_fixtures": { "type": "integer", "minimum": 0 },
        "min_reference_evidence_types": { "type": "integer", "minimum": 0 },
        "min_reference_patch_fixtures": { "type": "integer", "minimum": 0 },
        "min_reference_patch_count": { "type": "integer", "minimum": 0 },
        "min_approved_render_review_fixtures": { "type": "integer", "minimum": 0 },
        "min_debug_artifact_expectation_fixtures": { "type": "integer", "minimum": 0 },
        "min_render_dynamic_range_contract_fixtures": { "type": "integer", "minimum": 0 },
        "min_stitch_normalization_contract_fixtures": { "type": "integer", "minimum": 0 },
        "min_geometry_preparation_contract_fixtures": { "type": "integer", "minimum": 0 },
        "min_geometry_accuracy_contract_fixtures": { "type": "integer", "minimum": 0 },
        "min_orientation_accuracy_contract_fixtures": { "type": "integer", "minimum": 0 },
        "min_negative_reconstruction_contract_fixtures": { "type": "integer", "minimum": 0 },
        "min_grain_reduction_enabled_fixtures": { "type": "integer", "minimum": 0 },
        "min_grain_detail_contract_fixtures": { "type": "integer", "minimum": 0 },
        "min_grain_reduction_effect_contract_fixtures": { "type": "integer", "minimum": 0 },
        "required_film_stocks": { "$ref": "#/$defs/tagList" },
        "required_scene_tags": { "$ref": "#/$defs/tagList" },
        "required_exposure_tags": { "$ref": "#/$defs/tagList" },
        "required_calibration_cases": { "$ref": "#/$defs/tagList" },
        "required_scanner_profiles": { "$ref": "#/$defs/tagList" },
        "required_roll_profiles": { "$ref": "#/$defs/tagList" },
        "required_reference_evidence": { "$ref": "#/$defs/tagList" },
        "required_film_stock_calibration_pairs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pairLabel" }
        },
        "required_scene_exposure_pairs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pairLabel" }
        },
        "required_debug_artifact_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/debugArtifactKind" }
        }
      }
    },
    "fixtureEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component1"],
      "properties": {
        "component1": { "$ref": "#/$defs/pathString" },
        "component2": { "$ref": "#/$defs/pathString" },
        "component1_sha256": { "$ref": "#/$defs/sha256Hex" },
        "component2_sha256": { "$ref": "#/$defs/sha256Hex" },
        "additional_components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/additionalFixtureComponent" }
        },
        "output_dir": { "$ref": "#/$defs/pathString" },
        "input_mode": { "enum": ["negative", "positive"] },
        "bit_depth": { "enum": [14, 16] },
        "grain_reduction": { "enum": ["off", "on"] },
        "grain_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "grain_scale": { "type": "number", "minimum": 0.5, "maximum": 4 },
        "deskew": { "enum": ["auto", "manual", "off"] },
        "orientation_correction": {
          "enum": [
            "none",
            "flip-horizontal",
            "rotate-180",
            "flip-vertical",
            "rotate-90-clockwise-then-flip-horizontal",
            "rotate-90-clockwise",
            "rotate-270-clockwise-then-flip-horizontal",
            "rotate-270-clockwise"
          ]
        },
        "deskew_angle_degrees": { "type": "number", "minimum": -3, "maximum": 3 },
        "force_stitch": { "type": "boolean" },
        "force_no_stitch": { "type": "boolean" },
        "summary_baseline": { "$ref": "#/$defs/pathString" },
        "summary_baseline_sha256": { "$ref": "#/$defs/sha256Hex" },
        "calibration_profile": { "$ref": "#/$defs/pathString" },
        "calibration_profile_sha256": { "$ref": "#/$defs/sha256Hex" },
        "calibration_library": { "$ref": "#/$defs/pathString" },
        "calibration_library_sha256": { "$ref": "#/$defs/sha256Hex" },
        "scanner_profile": { "$ref": "#/$defs/nonEmptyString" },
        "roll_profile": { "$ref": "#/$defs/nonEmptyString" },
        "film_stock": { "$ref": "#/$defs/nonEmptyString" },
        "scene_tags": { "$ref": "#/$defs/tagList" },
        "exposure_tags": { "$ref": "#/$defs/tagList" },
        "reference_evidence": { "$ref": "#/$defs/tagList" },
        "render_review": { "$ref": "#/$defs/pathString" },
        "render_review_sha256": { "$ref": "#/$defs/sha256Hex" },
        "calibration_case": { "$ref": "#/$defs/nonEmptyString" },
        "expectations": { "$ref": "#/$defs/fixtureExpectations" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": { "required": ["deskew_angle_degrees"] },
          "then": {
            "required": ["deskew"],
            "properties": { "deskew": { "const": "manual" } }
          }
        },
        {
          "not": {
            "required": ["calibration_profile", "calibration_library"]
          }
        },
        {
          "not": {
            "required": ["force_stitch", "force_no_stitch"],
            "properties": {
              "force_stitch": { "const": true },
              "force_no_stitch": { "const": true }
            }
          }
        },
        {
          "if": { "required": ["summary_baseline_sha256"] },
          "then": { "required": ["summary_baseline"] }
        },
        {
          "if": { "required": ["render_review_sha256"] },
          "then": { "required": ["render_review"] }
        },
        {
          "if": { "required": ["calibration_profile_sha256"] },
          "then": { "required": ["calibration_profile"] }
        },
        {
          "if": { "required": ["calibration_library_sha256"] },
          "then": { "required": ["calibration_library"] }
        },
        {
          "if": { "required": ["component2_sha256"] },
          "then": { "required": ["component2"] }
        },
        {
          "if": { "required": ["additional_components"] },
          "then": { "required": ["component2"] }
        },
        {
          "if": {
            "properties": { "force_stitch": { "const": true } },
            "required": ["force_stitch"]
          },
          "then": { "required": ["component2"] }
        },
        {
          "if": {
            "required": ["component2"],
            "anyOf": [
              { "required": ["component1_sha256"] },
              { "required": ["component2_sha256"] }
            ]
          },
          "then": {
            "required": ["component1_sha256", "component2_sha256"]
          }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["scanner_profile"] },
              { "required": ["roll_profile"] }
            ]
          },
          "then": {
            "required": ["calibration_library"]
          }
        },
        {
          "if": { "required": ["roll_profile"] },
          "then": { "required": ["scanner_profile"] }
        },
        {
          "if": {
            "properties": { "calibration_case": { "const": "scanner-roll-library" } },
            "required": ["calibration_case"]
          },
          "then": {
            "required": ["calibration_library", "scanner_profile"]
          }
        },
        {
          "if": {
            "properties": { "calibration_case": { "const": "external-profile" } },
            "required": ["calibration_case"]
          },
          "then": {
            "required": ["calibration_profile"]
          }
        },
        {
          "if": {
            "properties": { "calibration_case": { "const": "uncalibrated-image-derived" } },
            "required": ["calibration_case"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["calibration_profile"] },
                { "required": ["calibration_library"] },
                { "required": ["scanner_profile"] },
                { "required": ["roll_profile"] }
              ]
            }
          }
        }
      ]
    },
    "additionalFixtureComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/pathString" },
        "sha256": { "$ref": "#/$defs/sha256Hex" }
      }
    },
    "borderCropComponentExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_index",
        "top_removed",
        "bottom_removed",
        "left_removed",
        "right_removed",
        "tolerance_px"
      ],
      "properties": {
        "component_index": { "type": "integer", "minimum": 1 },
        "top_removed": { "type": "integer", "minimum": 0 },
        "bottom_removed": { "type": "integer", "minimum": 0 },
        "left_removed": { "type": "integer", "minimum": 0 },
        "right_removed": { "type": "integer", "minimum": 0 },
        "tolerance_px": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "orientationComponentExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_index",
        "upright_approved",
        "decoded_pixel_sha256",
        "tag_present",
        "tag_value",
        "transform",
        "applied",
        "source_width",
        "source_height",
        "output_width",
        "output_height"
      ],
      "properties": {
        "component_index": { "type": "integer", "minimum": 1 },
        "upright_approved": { "type": "boolean" },
        "decoded_pixel_sha256": { "$ref": "#/$defs/sha256Hex" },
        "tag_present": { "type": "boolean" },
        "tag_value": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
        "transform": {
          "enum": [
            "identity",
            "flip_horizontal",
            "rotate_180",
            "flip_vertical",
            "rotate_90_clockwise_then_flip_horizontal",
            "rotate_90_clockwise",
            "rotate_270_clockwise_then_flip_horizontal",
            "rotate_270_clockwise"
          ]
        },
        "applied": { "type": "boolean" },
        "source_width": { "type": "integer", "minimum": 1 },
        "source_height": { "type": "integer", "minimum": 1 },
        "output_width": { "type": "integer", "minimum": 1 },
        "output_height": { "type": "integer", "minimum": 1 }
      }
    },
    "fixtureExpectations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deskew_status": { "$ref": "#/$defs/nonEmptyString" },
        "deskew_applied": { "type": "boolean" },
        "deskew_review_required": { "type": "boolean" },
        "deskew_retained_area_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "deskew_all_components_applied": { "type": "boolean" },
        "deskew_minimum_component_retained_area_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "border_crop_all_components_cropped": { "type": "boolean" },
        "border_crop_minimum_removed_edge_count_per_component_min": { "type": "integer", "minimum": 1 },
        "border_crop_retained_area_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "border_crop_retained_area_ratio_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "border_crop_rejected": { "type": "boolean" },
        "deskew_correction_degrees_expected": { "type": "number", "minimum": -3, "maximum": 3 },
        "deskew_correction_tolerance_degrees": { "type": "number", "minimum": 0, "maximum": 3 },
        "border_crop_components_expected": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/borderCropComponentExpectation" }
        },
        "orientation_components_expected": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/orientationComponentExpectation" }
        },
        "stitch_decision": { "$ref": "#/$defs/nonEmptyString" },
        "inferred_component_order": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "technical_white_balance_status": { "$ref": "#/$defs/nonEmptyString" },
        "technical_white_balance_applied": { "type": "boolean" },
        "technical_white_balance_review_required": { "type": "boolean" },
        "creative_temperature": { "type": "number", "minimum": -1, "maximum": 1 },
        "creative_tint": { "type": "number", "minimum": -1, "maximum": 1 },
        "seam_exposure_model": { "$ref": "#/$defs/nonEmptyString" },
        "seam_exposure_held_out_validation_passed": { "type": "boolean" },
        "seam_exposure_held_out_improvement_over_gain_min": { "type": "number", "minimum": 0 },
        "seam_exposure_offset_normalized_abs_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "seam_exposure_spatial_slope_abs_min": { "type": "number", "minimum": 0 },
        "seam_exposure_spatial_slope_abs_max": { "type": "number", "minimum": 0 },
        "seam_exposure_spatial_slope_agreement_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "seam_exposure_held_out_spatial_improvement_over_best_constant_min": { "type": "number", "minimum": 0 },
        "seam_exposure_spatial_offset_slope_normalized_abs_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "seam_exposure_spatial_offset_slope_normalized_abs_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "seam_exposure_spatial_offset_endpoint_normalized_abs_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "seam_exposure_spatial_affine_slope_agreement_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "seam_exposure_spatial_affine_center_offset_delta_normalized_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "seam_exposure_held_out_spatial_gain_offset_improvement_over_best_simpler_min": { "type": "number", "minimum": 0 },
        "seam_exposure_spatial_2d_gain_accepted": { "type": "boolean" },
        "seam_exposure_spatial_2d_gain_offset_accepted": { "type": "boolean" },
        "seam_exposure_spatial_quadratic_gain_accepted": { "type": "boolean" },
        "seam_exposure_spatial_quadratic_gain_offset_accepted": { "type": "boolean" },
        "seam_exposure_spatial_2d_distinct_columns_min": { "type": "integer", "minimum": 1 },
        "seam_exposure_spatial_2d_horizontal_slope_agreement_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "seam_exposure_held_out_spatial_2d_improvement_over_best_simpler_min": { "type": "number", "minimum": 0 },
        "seam_blend_required": { "type": "boolean" },
        "seam_blend_mode": { "$ref": "#/$defs/nonEmptyString" },
        "seam_blend_review_required": { "type": "boolean" },
        "seam_detail_review_required": { "type": "boolean" },
        "seam_detail_supported_scale_count_min": { "type": "integer", "minimum": 1 },
        "seam_detail_max_symmetric_energy_ratio_max": { "type": "number", "minimum": 1 },
        "seam_gradient_ratio_max": { "type": "number", "minimum": 0 },
        "seam_overlap_p95_abs_difference_max": { "type": "number", "minimum": 0 },
        "base_estimate_source": { "$ref": "#/$defs/nonEmptyString" },
        "base_confidence_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "density_inversion_skipped": { "type": "boolean" },
        "negative_response_model": { "$ref": "#/$defs/nonEmptyString" },
        "negative_response_source": { "$ref": "#/$defs/nonEmptyString" },
        "negative_response_accepted": { "type": "boolean" },
        "negative_response_review_required": { "type": "boolean" },
        "negative_response_crosstalk_model": { "$ref": "#/$defs/nonEmptyString" },
        "negative_response_characteristic_curve_model": { "$ref": "#/$defs/nonEmptyString" },
        "negative_response_measured_model_id": { "$ref": "#/$defs/nonEmptyString" },
        "negative_response_measured_confidence_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "negative_response_held_out_delta_e00_rms_max": { "type": "number", "minimum": 0 },
        "negative_response_held_out_max_delta_e00_max": { "type": "number", "minimum": 0 },
        "negative_response_held_out_improvement_over_unit_slope_min": { "type": "number", "minimum": 0 },
        "negative_response_density_noise_gain_max": { "type": "number", "minimum": 0 },
        "negative_response_curve_extrapolated_ratio_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "negative_response_signed_headroom_preserved": { "type": "boolean" },
        "negative_response_curve_interpolation": { "$ref": "#/$defs/nonEmptyString" },
        "output_color_space": { "$ref": "#/$defs/nonEmptyString" },
        "render_input_source": { "$ref": "#/$defs/nonEmptyString" },
        "render_input_reason_contains": { "$ref": "#/$defs/nonEmptyString" },
        "mapping_strategy": { "$ref": "#/$defs/nonEmptyString" },
        "selected_mapping_reason_contains": { "$ref": "#/$defs/nonEmptyString" },
        "selected_candidate": { "$ref": "#/$defs/nonEmptyString" },
        "selected_candidate_rank": {
          "type": "integer",
          "minimum": 0
        },
        "calibration_acceptance_status": { "$ref": "#/$defs/nonEmptyString" },
        "calibration_color_mapping_applied": { "type": "boolean" },
        "calibration_confidence_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "calibration_matrix_condition_number_max": {
          "type": "number",
          "minimum": 0
        },
        "calibration_rejection_details_required": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "candidate_risk": { "$ref": "#/$defs/nonEmptyString" },
        "tone_color_trust_state": { "$ref": "#/$defs/nonEmptyString" },
        "neutral_safety_rescue_applied": { "type": "boolean" },
        "neutral_safety_rescue_preserved_ratio_gain_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "neutral_safety_rescue_midtone_saturation_p95_reduction_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "neutral_safety_rescue_reason_contains": { "$ref": "#/$defs/nonEmptyString" },
        "highlight_chroma_compressed_ratio_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "highlight_chroma_compressed_ratio_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "highlight_neutral_chroma_compressed_ratio_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shadow_chroma_compressed_ratio_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "grain_reduction_enabled": { "type": "boolean" },
        "grain_reduction_applied_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "grain_reduction_structure_excluded_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "grain_reduction_flat_luma_p95_reduction_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "grain_reduction_flat_chroma_p95_reduction_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "grain_detail_review_required": { "type": "boolean" },
        "grain_detail_decision_supported": { "type": "boolean" },
        "grain_detail_luminance_probe_count_min": { "type": "integer", "minimum": 1 },
        "grain_detail_chroma_probe_count_min": { "type": "integer", "minimum": 1 },
        "grain_detail_luminance_p10_retention_min": { "type": "number", "minimum": 0, "maximum": 2 },
        "grain_detail_chroma_p10_retention_min": { "type": "number", "minimum": 0, "maximum": 2 },
        "selected_quality_score_max": {
          "type": "number",
          "minimum": 0
        },
        "technical_safety_score_max": {
          "type": "number",
          "minimum": 0
        },
        "color_fidelity_score_max": {
          "type": "number",
          "minimum": 0
        },
        "memory_color_penalty_max": {
          "type": "number",
          "minimum": 0
        },
        "spatial_consistency_penalty_max": {
          "type": "number",
          "minimum": 0
        },
        "selected_runner_up_quality_delta_min": {
          "type": "number",
          "minimum": 0
        },
        "density_monotonicity_score_min": {
          "type": "number",
          "minimum": 0
        },
        "hue_linearity_score_min": {
          "type": "number",
          "minimum": 0
        },
        "saturation_preservation_median_ratio_min": {
          "type": "number",
          "minimum": 0
